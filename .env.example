# ==============================================================================
# ALICORP BI v2 (JAVA 21+ / 26) - PLANTILLA DE VARIABLES DE ENTORNO
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo y renombralo a ".env" en la raiz del proyecto.
# 2. Reemplaza los valores de ejemplo con las credenciales reales compartidas
#    por el administrador del proyecto (NUNCA subas el archivo .env real a Git).
# 3. Si no creas el archivo .env, el sistema iniciara automaticamente usando
#    la base de datos local embebida H2 en modo compatibilidad Oracle (./data/).
# ==============================================================================

# URL JDBC del Pooler de Supabase PostgreSQL (Session Pooler recomendado: puerto 5432)
JDBC_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Usuario de conexion (en Supabase Pooler suele ser: postgres.<tu-project-ref>)
JDBC_USER=postgres.tu_project_ref

# Contrasena de la base de datos PostgreSQL / Supabase
JDBC_PASSWORD=TU_CONTRASENA_AQUI

# Puerto del servidor web Javalin (opcional, por defecto 5000)
# PORT=5000
